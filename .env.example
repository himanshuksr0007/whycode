# Copy to .env and fill in. Never commit a real .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Optional but strongly recommended: raises GitHub API limits 60 -> 5000/hr.
GITHUB_TOKEN=

# owner/name of the repo to ingest and demo on.
GITHUB_REPO=encode/httpx

WHYCODE_MAX_COMMITS=1200
WHYCODE_MAX_PRS=150
WHYCODE_MAX_ISSUES=150
WHYCODE_CONFIDENCE_THRESHOLD=0.45

# Optional LLM verbalizer (OpenAI-compatible endpoint). Leave unset for
# deterministic template answers.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
